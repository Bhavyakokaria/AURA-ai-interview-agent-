# Gemini API Key for AI Interview Agent
# Get your API key from Google AI Studio: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here

# Model configuration (optional fallback defaults to gemini-2.5-flash-lite)
GEMINI_MODEL=gemini-2.5-flash-lite

# Vercel KV (Upstash Redis) — required for persistent session storage in production.
# Find these values in your Vercel project dashboard under Storage > KV.
KV_REST_API_URL=your_kv_rest_api_url_here
KV_REST_API_TOKEN=your_kv_rest_api_token_here
